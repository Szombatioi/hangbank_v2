# Shared deployment config for docker-compose. Change these before any real use.

# Must be identical for the auth service (signs tokens) and the backend (verifies them).
JWT_SECRET=90a1f8a7954de761a913301be466520eb2345f4cfad4e96a06ca64faedcb38e0

# Public HTTPS origin served by Caddy (used for CORS + MinIO presigned URL rewriting).
PUBLIC_HTTPS_URL=https://localhost

# Hangbank backend database
HANGBANK_DB_USER=hangbank_admin
HANGBANK_DB_PASSWORD=hangbank_admin
HANGBANK_DB_NAME=hangbank_db

# Auth service database
AUTH_DB_USER=auth_admin
AUTH_DB_PASSWORD=auth_admin
AUTH_DB_NAME=auth_db

# MinIO object storage credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
