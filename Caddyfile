# Reverse proxy + TLS terminator for the whole app on a single HTTPS origin.
# Everything the browser touches (frontend, backend API, MinIO audio) is served
# same-origin over HTTPS, so there's no mixed-content blocking.

localhost {
	# Self-signed certificate issued by Caddy's built-in (internal) CA.
	# The browser will show a one-time "not trusted" warning — expected for a
	# self-signed cert. To trust it, import Caddy's root CA from the caddy_data volume.
	tls internal

	# Backend API — the browser calls /api/*, the backend serves routes without the prefix.
	handle_path /api/* {
		reverse_proxy hangbank-backend:3000
	}

	# MinIO object storage — presigned audio URLs are rewritten to /minio/* by the
	# backend. The signature was computed for the MinIO host, so forward it unchanged.
	handle_path /minio/* {
		reverse_proxy minio:9000 {
			header_up Host minio:9000
		}
	}

	# Next.js frontend — everything else.
	handle {
		reverse_proxy hangbank-frontend:3000
	}
}
